# Stage 10 settings: names and comments only (spec Appendix B). Never commit .env.
#
# How to use:
#   1. Create .env with the command in docs/session-handoff.md ("Create your .env"). It copies this file and fills
#      the local-only secrets with random values without printing them.
#   2. Check readiness without seeing any value:  scripts\preflight.ps1 -Profile core
#   3. Empty values mean "mock" or "Blocked". Never paste a secret into chat, a prompt, a commit or a command line.
#
# Order matters: a ${NAME} reference must come after the line that defines NAME (preflight checks this).

# ---------- Core ----------
# Which preflight profile this .env is for: core | observability | automation | live-ai | stage9-adapter | deploy
APP_PROFILE=core
# Signs sessions, CSRF tokens and approval bindings. Local random value, at least 32 characters.
APP_SECRET_KEY=
# true only for the public demo (v2): synthetic data, mock AI, rate limits, automatic reset.
PUBLIC_DEMO_MODE=false
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# ---------- Local database (Postgres in Docker) ----------
POSTGRES_USER=points
# Local random value, at least 8 characters.
POSTGRES_PASSWORD=
POSTGRES_DB=points
DATABASE_URL=postgresql+psycopg://points:${POSTGRES_PASSWORD}@localhost:5432/points
# Runtime database roles (RFC-0001 D9, ADR-0014): the ledger, the posting service and the outbox relay each log in
# with only their own rights, never as the superuser above. Local random values, at least 8 characters.
LEDGER_DB_PASSWORD=
POSTING_DB_PASSWORD=
RELAY_DB_PASSWORD=

# ---------- Kafka (KRaft, in Docker) ----------
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and the stack listens on IPv4 only.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081

# ---------- Ledger mock (simulated system of record) ----------
LEDGER_API_URL=http://localhost:8020
# Local random value, at least 12 characters. Rotating it must make the old one fail (a test proves it, M2).
LEDGER_API_TOKEN=

# ---------- AI ----------
# mock (default, offline, free) | anthropic (live; only after the owner approves a cap)
AI_PROVIDER=mock
# Live only. Set it yourself in .env; never paste it anywhere else.
ANTHROPIC_API_KEY=
# Live only. Default model for every stage: claude-haiku-5-5.
ANTHROPIC_MODEL=
# Hard caps in US dollars. A run stops when either is reached; mock runs count tokens at $0.
LLM_BUDGET_USD_PER_RUN=1.00
LLM_BUDGET_USD_DAILY=5.00

# ---------- Observability (local) ----------
# The local OpenTelemetry collector. Empty = traces stay in the process.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Local Grafana admin password, at least 12 characters.
GRAFANA_ADMIN_PASSWORD=

# ---------- Automation (v2) ----------
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=
# Signs webhooks between the investigator and n8n / mock Slack / mock Jira. At least 32 characters.
AUTOMATION_WEBHOOK_SECRET=
MOCK_SLACK_URL=
MOCK_JIRA_URL=
# Optional, real, and only with the owner's approval: a Slack incoming webhook to a personal test workspace.
SLACK_WEBHOOK_URL=

# ---------- Stage 9 adapter (v2, optional) ----------
STAGE9_API_URL=
STAGE9_API_TOKEN=

# ---------- Deployment (v2; AWS SSO only, no long-lived keys) ----------
AWS_PROFILE=
AWS_REGION=

# ---------- Feature flags ----------
# true only with AI_PROVIDER=anthropic and an approved cap.
FEATURE_LIVE_AI=false
# Alerts start read-only investigations automatically (within limits and the daily budget).
FEATURE_AUTO_INVESTIGATE=true
# Approved recoveries run against the simulated pipeline only.
FEATURE_RECOVERY_EXECUTION=true
FEATURE_N8N=false
